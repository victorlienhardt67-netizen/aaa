# Backend WhisperX auto-hébergé (voir voiceover_sync_backend/) — secrets serveur,
# jamais exposés au client.
VOICEOVER_SYNC_BACKEND_URL=
VOICEOVER_SYNC_API_KEY=

# Provider de transcription voix off : "whisper" (défaut) ou "elevenlabs".
# Whisper reste actif tant qu'aucune valeur n'est définie.
TRANSCRIPTION_PROVIDER=whisper

# Clé API ElevenLabs (Scribe) — nécessaire uniquement si TRANSCRIPTION_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=

# Termes clés (marques) transmis à Scribe pour améliorer la reconnaissance —
# liste séparée par des virgules, 100 termes max. Optionnel (valeur par défaut ci-dessous).
ELEVENLABS_KEYTERMS=Lynae,Lyveen,T-men,Venalys
